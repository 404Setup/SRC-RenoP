{
  "name": "renop-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "description": "RenoP official website",
  "scripts": {
    "build": "node ./build.mjs",
    "build:bundle": "rolldown -c rolldown.config.mjs",
    "test": "node --test ./test/*.test.mjs",
    "dev": "node ./build.mjs --watch",
    "preview": "node ./preview.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd", "sharp"]
  },
  "devDependencies": {
    "lightningcss": "^1.33.0",
    "rolldown": "^1.2.5"
  },
  "dependencies": {
    "@renop/ui": "workspace:*",
    "brotli-compress": "^2.2.2",
    "fflate": "^0.8.3",
    "marked": "^18.0.10"
  }
}
